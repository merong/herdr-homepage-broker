{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent read projection",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "project_id",
    "run_id",
    "agents"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "orchestration_mode": {
      "enum": [
        "claude-native",
        "pm-led",
        "legacy"
      ]
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent_id",
          "role",
          "model",
          "effort",
          "herdr",
          "runtime",
          "status",
          "waiting_reason"
        ],
        "properties": {
          "role": {
            "enum": [
              "pm",
              "developer",
              "designer"
            ]
          },
          "model": {
            "const": "claude-opus-5-5"
          },
          "effort": {
            "const": "high"
          },
          "status": {
            "enum": [
              "ready",
              "working",
              "waiting",
              "stopped",
              "failed"
            ]
          },
          "token": false
        }
      },
      "oneOf": [
        {
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "type": "object",
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "const": "pm"
                }
              }
            }
          ]
        },
        {
          "minItems": 3,
          "maxItems": 3,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "const": "pm"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "const": "developer"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "const": "designer"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      ]
    }
  },
  "if": {
    "required": [
      "orchestration_mode"
    ],
    "properties": {
      "orchestration_mode": {
        "const": "claude-native"
      }
    }
  },
  "then": {
    "properties": {
      "agents": {
        "maxItems": 1
      }
    }
  },
  "else": {
    "if": {
      "required": [
        "orchestration_mode"
      ]
    },
    "then": {
      "properties": {
        "agents": {
          "minItems": 3
        }
      }
    }
  }
}
