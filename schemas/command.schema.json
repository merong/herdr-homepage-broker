{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "type",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "enum": [
        "submit",
        "status",
        "answer",
        "apply-inputs",
        "feedback",
        "resume",
        "execute",
        "execution-status",
        "cancel",
        "report",
        "preview-start",
        "preview-stop",
        "media-request",
        "media-status",
        "reconcile"
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "submit"
          }
        }
      },
      "then": {
        "required": [
          "project_id"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "directory",
              "inputs"
            ],
            "properties": {
              "directory": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "inputs": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "prd",
                  "design"
                ],
                "properties": {
                  "prd": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  },
                  "design": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "status"
          }
        }
      },
      "then": {
        "required": [],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "answer"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "run_id"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "response"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "response": {},
              "terminal_resolved": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "apply-inputs"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "run_id"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inputs"
            ],
            "properties": {
              "inputs": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "prd",
                  "design"
                ],
                "properties": {
                  "prd": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  },
                  "design": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                }
              },
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "feedback": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "feedback"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "run_id"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inputs",
              "feedback"
            ],
            "properties": {
              "inputs": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "prd",
                  "design"
                ],
                "properties": {
                  "prd": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  },
                  "design": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                }
              },
              "feedback": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "resume"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "run_id"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "execute"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "run_id"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "start",
                  "resume"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "execution-status"
          }
        }
      },
      "then": {
        "required": [
          "project_id"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "cancel"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "run_id"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "report"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "run_id"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent_id",
              "token",
              "task_id",
              "assignment_id",
              "attempt",
              "event_id",
              "sequence",
              "kind"
            ],
            "properties": {
              "agent_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "token": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "task_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "assignment_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "event_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "team-create",
                  "plan",
                  "progress",
                  "completed",
                  "failed",
                  "question"
                ]
              },
              "tasks": {
                "type": "array"
              },
              "result": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "question_kind": {
                "enum": [
                  "execution_choice",
                  "requirements_change",
                  "terminal_action"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "response_schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "preview-start"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "run_id"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "argv"
            ],
            "properties": {
              "agent_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "token": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "preview-stop"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "run_id"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "agent_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "token": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "media-request"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "run_id"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "arguments"
            ],
            "properties": {
              "agent_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "token": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "arguments": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "media-status"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "run_id"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "reconcile"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "run_id"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "operation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "confirm_not_executed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  ]
}
